{
    "layer": "top",
    "modules-left": ["hyprland/workspaces", "cpu", "memory", "custom/music"],
    "modules-center": ["clock"],
    "modules-right": ["bluetooth", "network#eth", "pulseaudio"],
    "sway/window": {
        "max-length": 50,
    },
    "clock": {
        "format": "{:%a, %d. %b, %H:%M}",
        "format-alt": "{:%H:%M}",
    },
    "pulseaudio": {
        "format": "{icon} {volume}% ",
        "format-bluetooth": "{icon} {volume}%",
        "format-muted": "",
        "format-icons": {
            "headphone": "",
            "headset": "󰋎",
            "default": ["", ""],
        },
        "scroll-step": 1,
        "on-click": "pavucontrol",
        "ignored-sinks": ["Easy Effects Sink"],
    },
    "network#eth": {
        "interface": "enp42s0",
        "format-ethernet": "\uf796",
        "format-disconnected": "", //An empty format will hide the module.
        "tooltip-format-ethernet": "{ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 50,
    },
    "network#wlan": {
        "interface": "wlan0",
        "format-wifi": "\uf1eb",
        "format-disconnected": "", //An empty format will hide the module.
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 50,
    },
    "bluetooth": {
        "format": "󰂲",
        "format-on": "{icon}",
        "format-off": "{icon}",
        "format-connected": "{icon}",
        "format-icons": {
            "on": "󰂯",
            "off": "󰂲",
            "connected": "󰂱",
        },
        "on-click": "blueman-manager",
        "tooltip-format-connected": "{device_enumerate}",
    },
    "hyprland/workspaces": {
        "format": "{name}",
        "all-outputs": false,
    },
    "cpu": {
        "interval": 1,
        "format": " {usage}%",
        "format-icons": "",
        "on-click": "kitty -e btop",
    },
    "memory": {
        "interval": 30,
        "format": " {used:0.1f}G",
        "tooltip-format": "Memory",
    },
    "custom/music": {
        "format": "  {}",
        "escape": true,
        "exec": "playerctl metadata --format '{{artist}} - {{title}}'",
        "interval": 2,
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "max-length": 50,
        "tooltip": false,
    },
}
